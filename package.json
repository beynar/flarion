{
  "name": "flarion",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:workers": "vitest run --project workers",
    "deploy": "vite build && wrangler deploy",
    "deploy:staging": "vite build && wrangler deploy --env staging",
    "gen:theme": "node --experimental-strip-types scripts/gen-theme.ts",
    "gen:workspace-estate": "UPDATE_ESTATE=1 vitest run --project unit tests/unit/db/workspace-estate.test.ts",
    "db:generate": "node --experimental-strip-types scripts/db-generate.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261107.1",
    "@playwright/test": "^1.65.0",
    "@sveltejs/adapter-cloudflare": "8.0.2",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "svelte": "5.57.3",
    "svelte-check": "^4.7.8",
    "sveltekit-cloudflare-worker": "file:vendor/sveltekit-cloudflare-worker-0.0.1.tgz",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "4.1.12",
    "wrangler": "4.158.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp",
      "msgpackr-extract"
    ],
    "overrides": {
      "@effect/platform-node-shared": "4.0.0-beta.107",
      "effect": "4.0.0-beta.102"
    }
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "3.2.1",
    "@better-auth/passkey": "1.7.18",
    "@floating-ui/dom": "1.8.0",
    "@orpc/client": "1.16.2",
    "@orpc/contract": "1.16.2",
    "@orpc/openapi": "1.16.2",
    "@orpc/server": "1.16.2",
    "@orpc/valibot": "1.16.2",
    "better-auth": "1.7.18",
    "edytor": "7.0.4",
    "entasis": "0.16.0",
    "katex": "^0.19.1",
    "valibot": "1.5.0",
    "viborm": "1.12.1"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
